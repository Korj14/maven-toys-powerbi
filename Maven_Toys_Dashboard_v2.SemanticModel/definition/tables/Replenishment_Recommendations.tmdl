table Replenishment_Recommendations
	lineageTag: 3a1e6f01-f6d4-466b-ab7d-0a30148b437c

	measure 'Reorder Units' =
			
			IF(
			    [Scenario Selected] = 1,
			    SUM('Replenishment_Recommendations'[Budgeted_Order_Units]),
			    BLANK()
			)
		formatString: 0
		lineageTag: 19d91d06-46ce-436a-bc0e-0588611794ba

	measure 'Replenishment Budget Used' =
			
			IF(
			    [Scenario Selected] = 1,
			    SUM('Replenishment_Recommendations'[Recommended_Spend_USD]),
			    BLANK()
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 98f4cd2a-d057-4e62-aefa-742c506022d2

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Modeled Shortage Units Avoided' =
			
			IF(
			    [Scenario Selected] = 1,
			    SUM('Replenishment_Recommendations'[Modeled_Avoided_Shortage_Units]),
			    BLANK()
			)
		formatString: 0.00
		lineageTag: a9bdcd44-4944-4745-ba6f-f54e46be58ea

	measure 'Modeled Gross Profit Protected' =
			
			IF(
			    [Scenario Selected] = 1,
			    SUM('Replenishment_Recommendations'[Modeled_Protected_Gross_Profit_USD]),
			    BLANK()
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 8683c7e5-9a9e-414e-b7e7-6b0aa2115832

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Stores Requiring Replenishment' =
			
			IF(
			    [Scenario Selected] = 1,
			    CALCULATE(
			        DISTINCTCOUNT('Replenishment_Recommendations'[Store_ID]),
			        'Replenishment_Recommendations'[Budgeted_Order_Units] > 0
			    ),
			    BLANK()
			)
		formatString: 0
		lineageTag: 8f0ca70c-8efa-4e94-b544-cae964fd8218

	measure 'Shortage Without Order' =
			
			IF(
			    [Scenario Selected] = 1,
			    SUM('Replenishment_Recommendations'[Shortage_Units_No_Order]),
			    BLANK()
			)
		formatString: 0.00
		lineageTag: cd9bffef-6d34-488b-9af3-f12c9d08ad5e

	measure 'Shortage After Order' =
			
			IF(
			    [Scenario Selected] = 1,
			    SUM('Replenishment_Recommendations'[Shortage_Units_After_Order]),
			    BLANK()
			)
		formatString: 0.00
		lineageTag: 02f27348-3dd9-441f-9bf0-74ffc139f3f1

	measure 'Modeled Shortage Reduction %' =
			
			DIVIDE(
			    [Modeled Shortage Units Avoided],
			    [Shortage Without Order]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: eb403440-de77-464c-9509-49f651ee6a54

