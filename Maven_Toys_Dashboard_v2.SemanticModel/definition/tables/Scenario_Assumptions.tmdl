	column Assumption_Status
		dataType: string
		lineageTag: 5f615311-36ab-439f-95d8-0e9609edc3f1
		summarizeBy: none
		sourceColumn: Assumption_Status

		annotation SummarizationSetBy = Automatic

	partition Scenario_Assumptions = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Dev\maven_toys_extension\outputs_v03\Scenario_Assumptions.csv"),[Delimiter=",", Columns=6, Encoding=1252, QuoteStyle=QuoteStyle.None]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"Scenario_ID", type text}, {"Lead_Time_Days", Int64.Type}, {"Review_Period_Days", Int64.Type}, {"Target_Service_Level", type number}, {"Purchase_Budget_USD", Currency.Type}, {"Assumption_Status", type text}})
				in
				    #"Changed Type"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

