table Scenario_Assumptions
	lineageTag: bab3a1ee-c3d1-4dee-bfa3-ba7241acb23e

	measure 'Scenario Selected' =
			
			IF(
			    HASONEVALUE('Scenario_Assumptions'[Scenario_ID]),
			    1,
			    0
			)
		formatString: 0
		lineageTag: 1b44d4dc-974b-481c-9ebe-6b27e769380d

	column Scenario_ID
