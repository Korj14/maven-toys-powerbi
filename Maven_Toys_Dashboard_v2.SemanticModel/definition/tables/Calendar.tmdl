	column 'Year Month Sort'
		formatString: 0
		lineageTag: b8b1cf73-bcbd-497c-9c15-422b2c0c2241
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year Month Sort]

		annotation SummarizationSetBy = Automatic

	partition Calendar = calculated
		mode: import
		source = ```
				
				VAR FirstYear = YEAR(MIN(Sales[Date]))
				VAR LastYear = YEAR(MAX(Sales[Date]))
				RETURN
				ADDCOLUMNS(
				    CALENDAR(
				        DATE(FirstYear, 1, 1),
				        DATE(LastYear, 12, 31)
				    ),
				    "Year", YEAR([Date]),
				    "Month Number", MONTH([Date]),
				    "Month Name", FORMAT([Date], "MMM"),
				    "Month Year", FORMAT([Date], "MMM yyyy"),
				    "Year Month Sort", YEAR([Date]) * 100 + MONTH([Date])
				)
				
				```

	annotation PBI_Id = 9e206e4b581848268e4eb11b227cc17e

