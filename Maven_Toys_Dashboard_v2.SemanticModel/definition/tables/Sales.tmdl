table Sales
	lineageTag: 54ac57cb-94ca-404a-a4d4-164c3291f19e

	measure 'Total Units Sold' = SUM(Sales[Units])
		formatString: #,0
		lineageTag: 30cb0c8b-28ab-4c59-a55b-052ef90a9186

	measure 'Total Transactions' = ```
			DISTINCTCOUNT(Sales[Sale_ID])
			
			```
		formatString: #,0
		lineageTag: be5dec56-bc85-4460-86e0-8f152f752c82

	measure 'Total Revenue' = ```
			
			SUMX(
			    Sales,
			    Sales[Units] * RELATED(Products[Product_Price])
			)
			
			```
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 5be985b0-0146-4df5-a2a3-2a6cb2e3fcb4

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Total Cost' = ```
			
			SUMX(
			    Sales,
			    Sales[Units] * RELATED(Products[Product_Cost])
			)
			
			```
		lineageTag: faec507b-4879-437a-8b3c-f2d43074344b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Gross Profit' = ```
			[Total Revenue] - [Total Cost]
			
			```
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 5c1a8405-9a49-428b-8000-a7b6763e4df4

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Gross Margin %' = ```
			
			DIVIDE(
			    [Gross Profit],
			    [Total Revenue],
			    0
			)
			
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 621aa931-8c20-4357-b9a4-72284b828a44

	measure 'Average Transaction Value' = ```
			
			DIVIDE(
			    [Total Revenue],
			    [Total Transactions],
			    0
			)
			
			```
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 58aed12e-756d-4594-8105-d35b16bda8b4

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

