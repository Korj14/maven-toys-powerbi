table Forecast_28D
	lineageTag: 60aa2e1d-3687-4838-89d1-edc8ed9af8a2

	measure 'Forecast Units (28D)' =
			
			SUM('Forecast_28D'[Forecast_Units_28D])
		formatString: 0.00
		lineageTag: 90c9f35e-661d-40e4-a2e7-f940daf31ccd

	measure 'Forecast Revenue (28D)' =
			
			SUM('Forecast_28D'[Forecast_Revenue_USD])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 2c43e86b-f59c-43f2-9e59-6936573ffece

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Forecast Gross Profit (28D)' =
			
			SUM('Forecast_28D'[Forecast_Gross_Profit_USD])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 196e4df4-520b-4e34-b1b4-490ead27a2bb

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Forecast Gross Margin %' =
			
			DIVIDE(
			    [Forecast Gross Profit (28D)],
			    [Forecast Revenue (28D)]
			)
		formatString: #,0.00%;-#,0.00%;#,0.00%
		lineageTag: 3111fe54-b48f-44c3-8aa4-de993eaa2cf3

	measure 'Previous 28D Units' =
			
			SUM('Forecast_28D'[Actual_Units_Previous_28D])
		formatString: 0
		lineageTag: 0d28386e-45ec-4432-9e7d-42d00c69a87c

	measure 'Forecast Units Change %' =
			
			DIVIDE(
			    [Forecast Units (28D)] - [Previous 28D Units],
			    [Previous 28D Units]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 138ec754-7e64-4663-9007-0fcb44b8cbe5

