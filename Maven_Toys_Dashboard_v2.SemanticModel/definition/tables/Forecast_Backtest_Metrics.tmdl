	partition Forecast_Backtest_Metrics = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Dev\maven_toys_extension\outputs_v03\Forecast_Backtest_Metrics.csv"),[Delimiter=",", Columns=8, Encoding=1252, QuoteStyle=QuoteStyle.None]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
