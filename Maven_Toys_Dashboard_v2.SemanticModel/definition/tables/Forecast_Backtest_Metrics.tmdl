table Forecast_Backtest_Metrics
	lineageTag: f406cdfd-80a6-4a75-8cc4-b7be9620ce58

	measure 'Exploratory Holdout WAPE' =
			
			CALCULATE(
			    MAX('Forecast_Backtest_Metrics'[WAPE]),
			    'Forecast_Backtest_Metrics'[Evaluation_Set] = "holdout_seen_before",
			    'Forecast_Backtest_Metrics'[Method] = "pooled_blend_50"
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 796f6d6c-00a9-4683-93ab-dcea2bdf08e9

	column Evaluation_Set
		dataType: string
		lineageTag: e8d0c3c6-41d6-40fe-be8c-a0ad6215ab35
